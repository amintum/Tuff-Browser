<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_search_engine_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="@string/choose_search_engine_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/rg_search_engines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Brave Option -->
        <RadioButton
            android:id="@+id/rb_brave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:drawableStart="@drawable/ic_brave"
            android:drawablePadding="14dp"
            android:padding="12dp"
            android:text="@string/search_brave"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- DuckDuckGo Option -->
        <RadioButton
            android:id="@+id/rb_ddg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_duckduckgo"
            android:drawablePadding="14dp"
            android:padding="12dp"
            android:text="@string/search_ddg"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Google Option (With Warning) -->
        <RadioButton
            android:id="@+id/rb_google"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="14dp"
            android:padding="12dp"
            android:text="Google (Unsafe · Not recommended)"
            android:textColor="@color/warning_red"
            android:textSize="15sp" />

        <!-- Custom Engine Option -->
        <RadioButton
            android:id="@+id/rb_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_custom_search"
            android:drawablePadding="14dp"
            android:padding="12dp"
            android:text="@string/search_custom"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

    </RadioGroup>

    <!-- Custom URL Input (Hidden unless Custom is selected) -->
    <EditText
        android:id="@+id/et_custom_engine_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_omnibar"
        android:hint="@string/custom_engine_hint"
        android:inputType="textUri"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/primary"
        android:padding="12dp"
        android:text="@string/continue_btn"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

</LinearLayout>
