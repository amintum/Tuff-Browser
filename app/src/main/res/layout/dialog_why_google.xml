<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Why avoid Google?"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Google notoriously tracks search history, IP addresses, location data, and hardware fingerprints to build deep behavioral profiles.\n\nThese trackers follow your browsing across millions of third-party websites, compromising user privacy to fuel aggressive targeted ad networks.\n\nFor authentic privacy, Tuff Browser recommends using privacy-first engines like Brave Search or DuckDuckGo."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/btn_why_close"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_btn_cancel"
        android:gravity="center"
        android:text="Understood"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
